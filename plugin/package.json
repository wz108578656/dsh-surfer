{
  "name": "dsh-surfer",
  "version": "0.1.1",
  "description": "在 DSH 右侧栏用 Surfer WASM 打开 .vcd / .fst / .ghw 波形文件",
  "author": "zhuo.wang (wz108578656)",
  "homepage": "https://github.com/wz108578656/dsh-surfer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wz108578656/dsh-surfer.git",
    "directory": "plugin"
  },
  "bugs": {
    "url": "https://github.com/wz108578656/dsh-surfer/issues"
  },
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "surfer",
    "waveform",
    "vcd"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "engines": {
    "node": ">=20"
  }
}
